+// 지금보다 촘촘하게는 절대 권하지 않는다.
+function slotPeakJam(L,s){
+  let mx=0;
+  for(const h of SLOT[s].h) for(const [a,b] of segs(L)){
+    if(!isBuilt(L,a)||!isBuilt(L,b))continue;
+    const j=jamOf(L,a,b,h); if(j>mx)mx=j;
+  }
+  return mx;
+}
+function linePeakJam(L){ let mx=0; for(let s=0;s<4;s++){const j=slotPeakJam(L,s); if(j>mx)mx=j;} return mx; }
+function wasteOf(L){
+  const cur=headway[L].slice(), sug=cur.slice();
+  for(let s=0;s<4;s++){
+    const cap=Math.min(CFG.hwMax, CFG.hwSane[s]);   // 실제 지하철다운 선까지만 권한다
+    let best=cur[s];
+    for(let hw=cap; hw>=cur[s]; hw-=1){
+      headway[L][s]=hw;
+      if(slotPeakJam(L,s)<=CFG.jamAim){ best=hw; break; }
+    }
+    headway[L][s]=cur[s];
+    sug[s]=Math.max(cur[s],best);
+  }
+  if(sug.every((v,k)=>v<=cur[k]+0.01))return null;
+  const before=lineOpCost(L)+lineFixedCost(L);
+  for(let k=0;k<4;k++)headway[L][k]=sug[k];
+  const after=lineOpCost(L)+lineFixedCost(L), trains=lineTrains(L);
+  for(let k=0;k<4;k++)headway[L][k]=cur[k];
+  const save=before-after;
+  return save>1000?{sug,save,trains,now:lineTrains(L)}:null;
+}
